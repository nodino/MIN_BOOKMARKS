{
  "name": "react-example",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "bin": "build/server.js",
  "scripts": {
    "version": "node tools/bump-version.cjs && git add README.md DOCS/",
    "postversion": "git push origin HEAD --follow-tags",
    "build:pkg": "npm run build && tsc -p tsconfig.pkg.json && pkg package.json --output min-markers.exe",
    "dev": "tsx server.ts",
    "build": "npx vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xml2js": "^0.6.2"
  },
  "pkg": {
    "assets": [
      "dist/**"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "."
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
